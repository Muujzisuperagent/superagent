# 统一换行策略：仓库内以 LF 为准
* text=auto eol=lf

# ---- 二进制：不做换行转换，也不做文本 diff ----
*.docx binary
*.xlsx binary
*.pptx binary
*.pdf binary
*.png  binary
*.jpg  binary
*.zip  binary
*.pyc  binary

# ---- Windows 脚本保持 CRLF，方便记事本/ISE 打开 ----
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# ---- 必须 LF：shell hook（CRLF 会让 Git for Windows 的 sh 无法执行） ----
.githooks/* text eol=lf
*.sh text eol=lf
